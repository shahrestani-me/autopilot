# --------------------------------------------------------------------------
# CLI


def build_parser():
    p = argparse.ArgumentParser(prog="autopilot-linear", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("auth-check", help="verify the Keychain setup and who the token acts as")
    sub.add_parser("whoami", help="the Linear user the token acts as")
    sub.add_parser("users", help="the workspace's active people and their ids (for ALLOWED_USER_IDS)")

    q = sub.add_parser("queue", help="issues delegated to Autopilot, in run order")
    q.add_argument("--project", action="append", help="limit to a project name (repeatable)")
    q.add_argument("--team", help="limit to a team key, e.g. ENG")
    q.add_argument("--exclude-project", action="append", help="skip a project name (repeatable)")
    q.add_argument("--count", action="store_true", help="print only the number of takeable issues")
    q.add_argument("--next", action="store_true", help="print only the first takeable issue (or null)")
    q.add_argument("--queued", action="store_true",
                   help="with --count: only jobs no run has taken (not the running ones)")
    q.add_argument("--list", action="store_true",
                   help="gateway: every takeable job resolved like --next, in order ({items: [...]})")
    q.add_argument("--source", choices=["auto", "gateway", "linear"], default="auto",
                   help="auto: gateway jobs when the gateway is set up, else poll Linear")

    i = sub.add_parser("issue", help="an issue with comments and the latest Autopilot session")
    i.add_argument("id")

    c = sub.add_parser("comment", help="post a comment as Autopilot")
    c.add_argument("id")
    c.add_argument("--body")
    c.add_argument("--body-file", help="path, or - for stdin")

    o = sub.add_parser("ask-owner", help="top-level comment that @mentions the issue's creator (Linear notifies them)")
    o.add_argument("id")
    o.add_argument("--body")
    o.add_argument("--body-file", help="path, or - for stdin")
    o.add_argument("--fallback", help="a human's name or email when the creator is an app or unknown")

    a = sub.add_parser("activity", help="post an agent activity as Autopilot")
    a.add_argument("id")
    a.add_argument("--type", required=True, choices=["thought", "action", "elicitation", "response", "error"])
    a.add_argument("--body")
    a.add_argument("--body-file", help="path, or - for stdin")
    a.add_argument("--action")
    a.add_argument("--parameter")
    a.add_argument("--result")
    a.add_argument("--ephemeral", action="store_true", help="thought/action only")
    a.add_argument("--session", help="agent session id (default: the claimed job's, else the issue's live one)")

    s = sub.add_parser("state", help="set the issue's workflow state (name or type)")
    s.add_argument("id")
    s.add_argument("state")
    s.add_argument("--settle", type=int, default=0,
                   help="seconds to wait, then set it again if something else changed it (max 60)")

    au = sub.add_parser("automations", help="Linear PR automations that would fight Autopilot's statuses")
    au.add_argument("--team", action="append", required=True, help="team key, e.g. ENG (repeatable)")

    n = sub.add_parser("create", help="file a follow-up issue as Autopilot (never delegated to it)")
    n.add_argument("--team", required=True, help="team key, e.g. ENG")
    n.add_argument("--project", required=True)
    n.add_argument("--state", default="Backlog")
    n.add_argument("--title", required=True)
    n.add_argument("--body")
    n.add_argument("--body-file", help="path, or - for stdin")
    n.add_argument("--parent", help="parent issue ID")
    n.add_argument("--assignee", help="a human's Linear name or email; Linear notifies them")

    l = sub.add_parser("link", help="add an external link (e.g. the PR) to the Autopilot session")
    l.add_argument("id")
    l.add_argument("--label", required=True)
    l.add_argument("--url", required=True)
    l.add_argument("--session", help="agent session id (default: the claimed job's, else the issue's live one)")

    j = sub.add_parser("jobs", help="gateway jobs: next, or ack/done/blocked a job")
    j.add_argument("action", choices=["next", "get", "ack", "done", "blocked"])
    j.add_argument("job_id", nargs="?")
    j.add_argument("--note", help="done/blocked: one line, e.g. the PR URL or why it stopped")
    return p


def run(argv, client=None, gateway=None):
    args = build_parser().parse_args(argv)
    gw = gateway or Gateway()  # reads the Keychain only when a command needs it
    lin = client or Linear(expect_session=expect_own_session(gw))
    if args.cmd == "auth-check":
        v = lin.viewer()
        return {"ok": True, "viewer": v, "tokenSource": lin.token_source}
    if args.cmd == "whoami":
        return lin.viewer()
    if args.cmd == "users":
        return lin.users()
    if args.cmd == "queue":
        use_gw = args.source == "gateway" or (args.source == "auto" and not (args.project or args.team) and gw.enabled())
        if use_gw:
            try:
                return gateway_queue(gw, lin, args.count, args.next, args.exclude_project, args.list, args.queued)
            except GatewayDown as e:
                if args.source == "gateway":
                    raise
                # Delegations still work by polling; mentions wait until the gateway is back.
                print(f"autopilot-linear: warning: {e}; polling Linear instead", file=sys.stderr)
        q = lin.queue(args.project, args.team, args.exclude_project)
        if args.count:
            return q["count"]
        if args.next:
            return q["issues"][0] if q["issues"] else None
        return q
    if args.cmd == "issue":
        return lin.issue(args.id)
    if args.cmd == "comment":
        body = read_body(args)
        if not body:
            raise LinearError("comment needs --body or --body-file")
        return lin.comment(args.id, body)
    if args.cmd == "ask-owner":
        body = read_body(args)
        if not body:
            raise LinearError("ask-owner needs --body or --body-file")
        return lin.ask_owner(args.id, body, args.fallback)
    if args.cmd == "activity":
        if args.ephemeral and args.type not in ("thought", "action"):
            raise LinearError("only thought and action activities can be ephemeral")
        content = activity_content(args)
        out = lin.activity(args.id, content, args.ephemeral, session_for(args))
        if not getattr(args, "session", None) and content["type"] in MIRRORED_TYPES:
            mirrored = []
            for sid in mirror_sessions(args.id):
                try:
                    lin.activity(args.id, content, False, sid)
                    mirrored.append(sid)
                except LinearError as e:  # the main session has it; don't fail the run over a copy
                    print(f"autopilot-linear: warning: mirroring to session {sid} failed: {e}", file=sys.stderr)
            if mirrored and isinstance(out, dict):
                out = {**out, "mirroredTo": mirrored}
        return out
    if args.cmd == "state":
        return lin.set_state(args.id, args.state, max(0, min(args.settle, 60)))
    if args.cmd == "automations":
        return lin.automations(args.team)
    if args.cmd == "create":
        return lin.create_issue(args.team, args.project, args.state, args.title, read_body(args) or "", args.parent, args.assignee)
    if args.cmd == "link":
        return lin.add_link(args.id, args.label, args.url, session_for(args))
    if args.cmd == "jobs":
        if args.action == "next":
            return gw.next()
        if not args.job_id:
            raise LinearError(f"jobs {args.action} needs a job id")
        if args.action == "get":
            return gw.get(args.job_id)
        try:
            job = gw.update(args.job_id, args.action, args.note)
        except LinearError:
            if args.action != "ack":
                clear_current_job(args.job_id)  # finished or not, this run is done with it
            raise
        if args.action == "ack":
            if write_current_job(job):
                # The owner started a second session on this issue: say where the work is. Only a
                # note: the job is already acked, so a failure here must not fail the ack.
                try:
                    lin.activity(job["identifier"], {"type": "thought", "body": (
                        "Picked up together with the earlier session on this issue. Progress is posted there; "
                        "the result comes here too.")}, False, job["sessionId"])
                except LinearError as e:
                    print(f"autopilot-linear: warning: pointer to session {job['sessionId']} failed: {e}", file=sys.stderr)
        else:
            clear_current_job(job["id"])
        return job
    raise LinearError(f"unknown command {args.cmd}")


def main(argv=None):
    try:
        out = run(sys.argv[1:] if argv is None else argv)
    except SetupError as e:
        print(f"autopilot-linear: setup needed: {e}", file=sys.stderr)
        return 2
    except LinearError as e:
        print(f"autopilot-linear: {e}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"autopilot-linear: network error: {e.reason}", file=sys.stderr)
        return 1
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
